+grep -q '^FAIL missing missing-plugin-dir$' "$SCRATCH_ROOT/audit.out" || fail "missing launcher did not FAIL"
+grep -q '^audit total=2 pass=1 fail=1$' "$SCRATCH_ROOT/audit.out" || fail "audit summary was unexpected"
